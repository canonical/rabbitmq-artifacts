#!/bin/sh
# Creates the writable layout and seeds the default config.
#
# '584792' is the _daemon_ user and group.

set -eux

CONF="$SNAP_DATA/etc/rabbitmq"
LOGS="$SNAP_COMMON/var/log/rabbitmq"
DATA="$SNAP_COMMON/var/lib/rabbitmq"

mkdir -p "$CONF/conf.d" "$LOGS" "$DATA/mnesia"

cp "$SNAP"/etc/rabbitmq/* "$CONF"

chown -R 584792:root "$CONF" "$LOGS" "$DATA"
chmod -R u=rwX,g=rwX,o= "$CONF" "$LOGS"
chmod 750 "$DATA" "$DATA/mnesia"
